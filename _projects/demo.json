em-ui, sans-serif;\n  background: #ecfdf5;\n  color: #134e4a;\n}\n\n.card {\n  width: min(420px, 90vw);\n  padding: 28px;\n  border-radius: 16px;\n  background: #fff;\n  box-shadow: 0 12px 40px rgb(15 118 110 / 12%);\n  text-align: center;\n}\n\nh1 {\n  margin: 16px 0 8px;\n  color: #0f766e;\n}\n\nbutton {\n  margin-top: 8px;\n  border: 0;\n  border-radius: 8px;\n  padding: 10px 16px;\n  background: #0f766e;\n  color: #fff;\n  font-weight: 600;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background: #115e59;\n}\n\n#msg {\n  min-height: 1.5em;\n  color: #0f766e;\n  font-weight: 600;\n}\n","binary":false}],"entry":"index.html"}
