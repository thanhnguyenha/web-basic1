{"tree":[{"type":"file","path":"index.html","name":"index.html"}],"files":[{"path":"index.html","name":"index.html","lang":"html","content":"<!DOCTYPE html>\n<html lang=\"vi\">\n  <head>\n    <title>Bảng điểm danh Mùa hè xanh 2026</title>\n  </head>\n  <body>\n    <h1>Danh sách đội tình nguyện — Mùa hè xanh 2026</h1>\n    <p>\n      Bảng dưới đây là kết quả bài 9. Hãy chỉnh sửa để gộp ô theo yêu cầu bài 10.\n    </p>\n\n    <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" width=\"100%\">\n      <tr>\n        <th>STT</th>\n        <th>Họ và tên</th>\n        <th>Đội</th>\n        <th>Nhiệm vụ</th>\n      </tr>\n      <tr>\n        <td align=\"center\">1</td>\n        <td>Nguyễn Văn An</td>\n        <td>Đội Xanh</td>\n        <td>Trồng cây</td>\n      </tr>\n      <tr>\n        <td align=\"center\">2</td>\n        <td>Trần Thị Bình</td>\n        <td>Đội Xanh</td>\n        <td>Dạy học</td>\n      </tr>\n      <tr>\n        <td align=\"center\">3</td>\n        <td>Lê Minh Cường</td>\n        <td>Đội Đỏ</td>\n        <td>Y tế</td>\n      </tr>\n      <tr>\n        <td align=\"center\">4</td>\n        <td>Phạm Thu Dung</td>\n        <td>Đội Đỏ</td>\n        <td>Y tế</td>\n      </tr>\n    </table>\n  </body>\n</html>\n","binary":false}],"entry":"index.html"}
